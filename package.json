{
  "name": "typstographe",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "start": "npm run tauri --workspace @typstographe/app -- dev",
    "dev": "npm start --",
    "tauri": "npm run tauri --workspace @typstographe/app --",
    "build": "npm run tauri --workspace @typstographe/app -- build --no-bundle",
    "build:web": "npm run build --workspace @typstographe/app",
    "test": "npm test --workspace @typstographe/app",
    "test:coverage": "npm run test:coverage --workspace @typstographe/app",
    "test:browser": "npm run test:browser --workspace @typstographe/app --",
    "test:browser:smoke": "npm run test:browser:smoke --workspace @typstographe/app --",
    "test:native": "npm run test:native --workspace @typstographe/app --",
    "test:preview-native": "npm run test:preview-native --workspace @typstographe/app --",
    "check:format": "npm run check:format --workspace @typstographe/app",
    "check:rust": "cargo clippy --locked -p typstographe --all-targets -- -D warnings",
    "test:rust": "cargo test --locked -p typstographe --features recipe-driver",
    "test:contract": "cargo build --locked -p typstographe --features recipe-driver && npm run test:contract --workspace @typstographe/app",
    "test:closure-native": "npm run test:closure-native --workspace @typstographe/app --",
    "test:draft-conservation-native": "npm run test:draft-conservation-native --workspace @typstographe/app --",
    "test:publication-native": "npm run test:publication-native --workspace @typstographe/app --",
    "build:recipe": "node app/scripts/build-recipe.mjs",
    "check:distribution": "node app/scripts/check-distribution.mjs"
  }
}
