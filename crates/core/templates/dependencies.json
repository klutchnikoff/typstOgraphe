{
  "version": 1,
  "capabilities": [
    {
      "id": "dates",
      "entrypoint": "capabilities/dates.typ",
      "signature": "format-date(value, lang: \"fr\") -> content",
      "packages": [
        "datify"
      ]
    },
    {
      "id": "correspondence",
      "entrypoint": "capabilities/correspondence.typ",
      "signature": "postscript(body), attachment(body), letter-notes(postscript: body => body, attachments: items => items.join(parbreak()))",
      "packages": []
    },
    {
      "id": "authorship",
      "entrypoint": "capabilities/authorship.typ",
      "signature": "prepare-authorship(authors, affiliations), show-authorship(prepared, render-author: auto, render-affiliation: auto)",
      "packages": []
    },
    {
      "id": "abstracts",
      "entrypoint": "capabilities/abstracts.typ",
      "signature": "show-abstracts(localizations, primary-language: \"fr\", render-entry: auto)",
      "packages": []
    },
    {
      "id": "references",
      "entrypoint": "capabilities/references.typ",
      "signature": "citation(body, form: \"normal\"), reference-list(sources, style: \"chicago-author-date\")",
      "packages": []
    },
    {
      "id": "tables",
      "entrypoint": "capabilities/tables.typ",
      "signature": "table-header-cell(body, scope: \"row\") -> content; external Typst CLI requires --features a11y-extras",
      "packages": []
    }
  ],
  "packages": [
    {
      "name": "datify",
      "version": "1.3.0",
      "root": "packages/datify-1.3.0",
      "entrypoint": "src/main.typ",
      "license": "MIT",
      "archive": "https://packages.typst.org/preview/datify-1.3.0.tar.gz",
      "sha256": "43f313ea6b463469080cfa61e404d51a2d70d7aead6e5365f9b4dc7163519ac6",
      "dependencies": [
        "datify-core"
      ]
    },
    {
      "name": "datify-core",
      "version": "2.1.0",
      "root": "packages/datify-core-2.1.0",
      "entrypoint": "src/main.typ",
      "license": "MIT AND Unicode-3.0",
      "archive": "https://packages.typst.org/preview/datify-core-2.1.0.tar.gz",
      "sha256": "5a3621f82e88098e8924f811f86b2733e8eeed3a6f08ac8e42507888ef0c29e6",
      "dependencies": []
    }
  ]
}
