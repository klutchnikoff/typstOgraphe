{
  "name": "@typstographe/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "node scripts/tauri.mjs",
    "test": "vitest run && node --test scripts/native-locales.test.mjs",
    "test:browser": "playwright test",
    "test:native": "node scripts/native-recipe.mjs",
    "test:preview-native": "node scripts/preview-performance.mjs",
    "check:format": "prettier --check src tests contracts scripts browser-driver.ts playwright.config.ts vite.config.ts vitest.config.ts package.json tsconfig.json",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --features recipe-driver",
    "test:contract": "vitest run --config contracts/vitest.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "lib0": "0.2.119",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
