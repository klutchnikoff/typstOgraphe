{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typstOgraphe",
  "version": "0.1.0",
  "identifier": "org.typstographe.web-editor-spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "typstOgraphe",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/linux/32x32.png",
      "icons/linux/128x128.png",
      "icons/linux/128x128@2x.png",
      "icons/linux/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
