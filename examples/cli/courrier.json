{
  "version": 1,
  "document": {
    "kind": "new",
    "type": "courrier"
  },
  "steps": [
    {
      "id": "metadata.set",
      "params": {
        "target": {
          "kind": "metadata",
          "field": "sender.name"
        },
        "value": "Camille Martin"
      }
    },
    {
      "id": "metadata.set",
      "params": {
        "target": {
          "kind": "metadata",
          "field": "sender.address"
        },
        "value": "12 rue des Fleurs\n35000 Rennes"
      }
    },
    {
      "id": "metadata.set",
      "params": {
        "target": {
          "kind": "metadata",
          "field": "recipient.name"
        },
        "value": "Service des équipements"
      }
    },
    {
      "id": "metadata.set",
      "params": {
        "target": {
          "kind": "metadata",
          "field": "recipient.address"
        },
        "value": "1 place de la Mairie\n35000 Rennes"
      }
    },
    {
      "id": "metadata.set",
      "params": {
        "target": {
          "kind": "metadata",
          "field": "letter.place"
        },
        "value": "Rennes"
      }
    },
    {
      "id": "metadata.set",
      "params": {
        "target": {
          "kind": "metadata",
          "field": "letter.date"
        },
        "value": "2026-10-24"
      }
    },
    {
      "id": "metadata.set",
      "params": {
        "target": {
          "kind": "metadata",
          "field": "letter.subject"
        },
        "value": "Demande de réservation"
      }
    },
    {
      "id": "block.splice",
      "params": {
        "parent": {
          "root": {
            "kind": "body"
          }
        },
        "index": 0,
        "delete_count": 1,
        "nodes": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Madame, Monsieur,"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Je souhaite connaître les modalités de réservation de votre salle."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Je vous remercie pour votre retour."
              }
            ]
          },
          {
            "type": "postscript",
            "content": [
              {
                "type": "text",
                "text": "Vous pouvez me répondre par courrier."
              }
            ]
          },
          {
            "type": "attachment",
            "content": [
              {
                "type": "text",
                "text": "Formulaire de demande"
              }
            ]
          },
          {
            "type": "paragraph"
          }
        ]
      }
    },
    {
      "id": "text.bold",
      "target": {
        "select": "modalités de réservation"
      }
    }
  ],
  "save": {
    "kind": "as",
    "path": "../../output/courrier-script.typsto"
  }
}
