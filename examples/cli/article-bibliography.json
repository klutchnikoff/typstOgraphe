                    "content": [
                      {
                        "type": "text",
                        "text": "Écrire et transmettre les savoirs"
                      }
                    ]
                  }
                ]
              },
              "short-title": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Écrire et transmettre"
                      }
                    ]
                  }
                ]
              },
              "subtitle": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Pratiques éditoriales et travail collectif dans la recherche"
                      }
                    ]
                  }
                ]
              },
              "abstract": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "L’écriture scientifique ne se réduit pas à la restitution de résultats. Elle organise un travail de sélection, de mise en relation et de discussion des connaissances. Cet article de démonstration propose une réflexion sur les conditions matérielles de cette activité et sur la place des outils de composition dans le travail collectif. Il distingue les choix qui relèvent des auteurs de ceux qui appartiennent à la présentation éditoriale, afin de faciliter la lecture et la circulation des textes."
                      }
                    ]
                  }
                ]
              },
              "keywords": [
                "écriture scientifique",
                "travail collectif",
                "édition",
                "sciences humaines et sociales"
              ]
            },
            {
              "id": "en",
              "language": "en",
              "title": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Writing and sharing knowledge"
                      }
                    ]
                  }
                ]
              },
              "short-title": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph"
                  }
                ]
              },
              "subtitle": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Editorial practices and collective work in research"
                      }
                    ]
                  }
                ]
              },
              "abstract": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Scholarly writing involves more than reporting results. It brings together the selection, organisation and discussion of knowledge. This demonstration article considers the material conditions of this activity and the role of document tools in collaborative work. It distinguishes authors’ decisions from editorial presentation choices, with a view to making texts easier to read, review and share."
                      }
                    ]
                  }
                ]
              },
              "keywords": ["scholarly writing", "collaboration", "publishing"]
            }
          ]
        }
